{
  "compilerOptions": {
    "target": "ES2020",
    "moduleResolution": "node",
    "module": "commonjs",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@pages": ["src/pages"],
      "@pages/*": ["src/pages/*"],
      "@components/*": ["src/components/*"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": ["src", "tests"]
}